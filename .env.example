# Optional for local development. When both are absent, API routes use in-memory storage.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
SUPABASE_URL=https://your-project.supabase.co
# Server-only secret. Never rename this to NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public Supabase Auth key, kept server-side because OAuth starts in a route handler.
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional dedicated HMAC secret for privacy-preserving API rate-limit buckets.
# If omitted, the server-only service role key is used.
RATE_LIMIT_SECRET=

# Required for paid story generation.
OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-5.6-luna

# Toss Payments paired test_ or live_ keys. The client key is public; the secret key is server-only.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_your-client-key
TOSS_SECRET_KEY=test_gsk_your-secret-key

# Required before live payments. These values are displayed in the site footer and policies.
BUSINESS_NAME=
BUSINESS_REPRESENTATIVE=
BUSINESS_REGISTRATION_NUMBER=
BUSINESS_ADDRESS=
CUSTOMER_SUPPORT_EMAIL=
CUSTOMER_SUPPORT_PHONE=
MAIL_ORDER_REGISTRATION_NUMBER=
PRIVACY_OFFICER_NAME=
