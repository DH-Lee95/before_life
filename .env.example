# Optional for local development. When both are absent, API routes use in-memory storage.
SUPABASE_URL=https://your-project.supabase.co
# Server-only secret. Never rename this to NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional OpenAI story preview configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
